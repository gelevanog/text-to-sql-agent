# Copy to .env and adjust. Every variable is optional; the defaults run the demo with the offline model.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------
# Owner connection: creates the demo schema, the reader role and Tally's own tables (audit log, conversations).
TALLY_DATABASE_URL=postgresql://tally:tally@localhost:5432/tally
# Read-only login that every generated query runs as. Empty = TALLY_DATABASE_URL with the reader's credentials.
TALLY_READER_DATABASE_URL=
TALLY_READER_ROLE=tally_reader
TALLY_READER_PASSWORD=tally_reader
# NOLOGIN role (granted to the reader) whose row-level security policy admits only TALLY_REGION_SCOPE's rows.
TALLY_SCOPED_READER_ROLE=tally_scoped_reader
# Schema with the business tables, and Tally's own schema (the reader has no access to it).
TALLY_DATA_SCHEMA=public
TALLY_APP_SCHEMA=tally
# Generate the Lumora demo database on API startup when the data schema is empty.
TALLY_SEED_DEMO=true
TALLY_DEMO_SEED=42
TALLY_DEMO_SCALE=1.0

# ---------------------------------------------------------------------------------------------------------
# Execution guard
# ---------------------------------------------------------------------------------------------------------
TALLY_STATEMENT_TIMEOUT_MS=5000
# Row cap: LIMIT is enforced in the SQL and rows are fetched up to this many.
TALLY_MAX_ROWS=1000
# Cost guard: refuse a query if any plan node is estimated above this many rows, or the total cost above this.
TALLY_MAX_PLAN_ROWS=5000000
TALLY_MAX_PLAN_COST=50000000
# Row-level security (opt-in; it slows planning, see README): create the policies at seed time, then scope
# every query to one region code (EU, NA, ...). '*' = no scope.
TALLY_RLS=false
TALLY_REGION_SCOPE=*

# ---------------------------------------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------------------------------------
# ask = ask a clarifying question for ambiguous terms; assume = use the semantic layer's default and say so.
TALLY_CLARIFY_POLICY=ask
# Retries after a SQL error, a validation failure, a too-expensive plan or an empty result.
TALLY_MAX_CORRECTIONS=2
# retrieval = only the relevant tables, views and metrics; full = the whole schema (ablation).
TALLY_RETRIEVAL_MODE=retrieval
TALLY_SEMANTIC_LAYER=true
TALLY_SEMANTIC_LAYER_FILE=configs/semantic_layer.yaml
TALLY_RETRIEVAL_TOP_TABLES=6
TALLY_RETRIEVAL_TOP_METRICS=3
# Earlier turns of a conversation sent with a follow-up.
TALLY_HISTORY_TURNS=3
# Re-asks for an answer whose numbers are not in the result, before falling back to a template answer.
TALLY_ANSWER_RETRIES=1
# The date the agent treats as today (fixed for the demo data so relative dates are reproducible). Empty = real date.
TALLY_TODAY=2026-10-01

# Optional cloud embeddings for schema retrieval (BM25 + synonyms is the default; nothing runs locally).
TALLY_EMBEDDINGS=off
TALLY_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
TALLY_EMBEDDING_WEIGHT=0.5

# ---------------------------------------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------------------------------------
# fake (offline demo model) | openrouter | qwen (Qwen Cloud / DashScope) | openai | anthropic | openai_compatible
TALLY_LLM_PROVIDER=fake
# Empty = provider default (openrouter: nvidia/nemotron-3-super-120b-a12b:free, qwen: qwen3-coder-next,
# openai: gpt-5-mini, anthropic: claude-sonnet-5).
TALLY_LLM_MODEL=
# OpenRouter fallback list (comma-separated), sent as `models`; the first one is also asked directly when the
# provider refuses a prompt with HTTP 403.
TALLY_LLM_FALLBACK_MODELS=
# For openai_compatible (vLLM, LM Studio, a gateway).
TALLY_LLM_BASE_URL=
# TALLY_LLM_API_KEY=
TALLY_LLM_TIMEOUT_SECONDS=120
TALLY_LLM_MAX_TOKENS=4000
TALLY_LLM_TEMPERATURE=0
# Sent to OpenRouter as reasoning.effort for reasoning models (empty = not sent).
TALLY_LLM_REASONING_EFFORT=low
# Refuse any OpenRouter model id that does not end in ":free" (and reject answers served by a paid model).
TALLY_REQUIRE_FREE_MODELS=true

# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Qwen Cloud: QWEN_API_KEY (or DASHSCOPE_API_KEY). Token Plan international endpoint by default; pay-as-you-go:
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (international), https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=
TALLY_QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Sent as enable_thinking to Qwen3 hybrid-thinking models when set (true/false); unset = not sent.
# TALLY_QWEN_ENABLE_THINKING=false
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
TALLY_ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------------------------------------------
# Budget for real cloud calls
# ---------------------------------------------------------------------------------------------------------
# Disk cache of model responses keyed by the full request (the evaluation always turns it on).
TALLY_LLM_CACHE=false
TALLY_LLM_CACHE_DIR=.cache/llm
# Every real request (retries included) is appended here: model ids, status, latency, tokens; never prompts.
TALLY_LLM_LEDGER=results/calls.jsonl
# Hard budget: requests stop once the ledger holds this many.
TALLY_LLM_MAX_CALLS=500
TALLY_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3.0
TALLY_LLM_MAX_RETRIES=4

# ---------------------------------------------------------------------------------------------------------
# API and logging
# ---------------------------------------------------------------------------------------------------------
TALLY_CORS_ORIGINS=http://localhost:3000
TALLY_RESULTS_DIR=results
TALLY_BENCHMARK_FILE=data/benchmark/questions.yaml
LOG_LEVEL=INFO
# console (human-readable) or json
LOG_FORMAT=console

# ---------------------------------------------------------------------------------------------------------
# docker compose only
# ---------------------------------------------------------------------------------------------------------
# API_PORT=8000
# WEB_PORT=3000
# POSTGRES_PASSWORD=tally
