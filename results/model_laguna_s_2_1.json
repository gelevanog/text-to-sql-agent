   "category": "period_over_period",
   "expect": "answer",
   "question": "What was the refund rate in each region in 2025 compared with 2026 so far?",
   "status": "answered",
   "sql": "WITH regional_refunds AS (\n  SELECT\n    region_code,\n    SUM(CASE WHEN ordered_at >= DATE '2025-01-01' AND ordered_at < DATE '2026-01-01'\n             THEN refund_usd ELSE 0 END) AS refund_2025,\n    SUM(CASE WHEN ordered_at >= DATE '2025-01-01' AND ordered_at < DATE '2026-01-01'\n             THEN gross_revenue_usd ELSE 0 END) AS gross_2025,\n    SUM(CASE WHEN ordered_at >= DATE '2026-01-01' AND ordered_at < DATE '2026-10-01'\n             THEN refund_usd ELSE 0 END) AS refund_2026,\n    SUM(CASE WHEN ordered_at >= DATE '2026-01-01' AND ordered_at < DATE '2026-10-01'\n             THEN gross_revenue_usd ELSE 0 END) AS gross_2026\n  FROM order_revenue\n  WHERE ordered_at >= DATE '2025-01-01' AND ordered_at < DATE '2026-10-01'\n  GROUP BY region_code\n)\nSELECT\n  region_code,\n  ROUND(refund_2025, 2) AS refund_usd_2025,\n  ROUND(gross_2025, 2) AS gross_revenue_2025,\n  ROUND(refund_2025 / NULLIF(gross_2025, 0), 4) AS refund_rate_2025,\n  ROUND(refund_2026, 2) AS refund_usd_2026,\n  ROUND(gross_2026, 2) AS gross_revenue_2026,\n  ROUND(refund_2026 / NULLIF(gross_2026, 0), 4) AS refund_rate_2026,\n  ROUND(refund_2026 / NULLIF(gross_2026, 0) - refund_2025 / NULLIF(gross_2025, 0), 4) AS diff,\n  ROUND((refund_2026 / NULLIF(gross_2026, 0) - refund_2025 / NULLIF(gross_2025, 0)) / NULLIF(refund_2025 / NULLIF(gross_2025, 0), 0), 4) AS pct_change\nFROM regional_refunds\nORDER BY region_code;",
