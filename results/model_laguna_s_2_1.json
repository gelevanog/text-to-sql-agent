  {
   "id": "pop_01",
   "category": "period_over_period",
   "expect": "answer",
   "question": "What was net revenue by region last calendar quarter vs the one before?",
   "status": "answered",
   "sql": "WITH q2 AS (\n  SELECT\n    region_code,\n    region_name,\n    SUM(net_revenue_usd) AS q2_net_revenue\n  FROM order_revenue\n  WHERE ordered_at >= DATE '2026-04-01' AND ordered_at < DATE '2026-07-01'\n  GROUP BY region_code, region_name\n),\nq3 AS (\n  SELECT\n    region_code,\n    region_name,\n    SUM(net_revenue_usd) AS q3_net_revenue\n  FROM order_revenue\n  WHERE ordered_at >= DATE '2026-07-01' AND ordered_at < DATE '2026-10-01'\n  GROUP BY region_code, region_name\n)\nSELECT\n  COALESCE(q3.region_code, q2.region_code) AS region_code,\n  COALESCE(q3.region_name, q2.region_name) AS region_name,\n  ROUND(COALESCE(q2.q2_net_revenue, 0), 2) AS prev_quarter_net_revenue,\n  ROUND(COALESCE(q3.q3_net_revenue, 0), 2) AS last_quarter_net_revenue,\n  ROUND(COALESCE(q3.q3_net_revenue, 0) - COALESCE(q2.q2_net_revenue, 0), 2) AS revenue_diff,\n  ROUND(\n    (COALESCE(q3.q3_net_revenue, 0) - COALESCE(q2.q2_net_revenue, 0))\n      / NULLIF(COALESCE(q2.q2_net_revenue, 0), 0),\n    4\n  ) AS pct_change\nFROM q2\nFULL OUTER JOIN q3 ON q2.region_code = q3.region_code\nORDER BY last_quarter_net_revenue DESC;",
